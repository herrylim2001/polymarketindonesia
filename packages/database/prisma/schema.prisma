// Prisma Schema for PolyID - Indonesian Prediction Market

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String?

  // Profile
  avatar        String?
  phone         String?

  // Wallet
  balance       Decimal   @default(0) @db.Decimal(18, 2)

  // Stats
  totalBets     Int       @default(0)
  totalWins     Int       @default(0)
  totalProfit   Decimal   @default(0) @db.Decimal(18, 2)

  // KYC
  kycStatus     KycStatus @default(NONE)
  kycLevel      Int       @default(0)
  kycDocuments  KycDocument[]

  // Referral
  referralCode  String?   @unique
  referredBy    User?     @relation("Referral", fields: [referredById], references: [id])
  referredById  String?
  referrals     User[]    @relation("Referral")
  referralEarnings Decimal @default(0) @db.Decimal(18, 2)

  // Status
  isActive      Boolean   @default(true)
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?

  // Metadata (for password reset tokens, etc.)
  metadata      Json?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  bets          Bet[]
  transactions  Transaction[]
  notifications Notification[]
  bookmarks     Bookmark[]
  comments      Comment[]
  sessions      Session[]

  @@index([email])
  @@index([username])
  @@index([referralCode])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt    DateTime @default(now())

  @@index([userId])
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model KycDocument {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   // ktp, sim, passport
  documentUrl String
  documentNumber String?
  status      KycStatus @default(PENDING)
  rejectedReason String?

  // Verified data extracted from document
  verifiedData Json?

  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// ============================================
// MARKETS & OUTCOMES
// ============================================

model Market {
  id            String        @id @default(cuid())

  // Basic Info
  title         String
  description   String        @db.Text
  category      Category
  imageUrl      String?
  source        String?

  // Timing
  startDate     DateTime      @default(now())
  endDate       DateTime
  resolvedAt    DateTime?

  // Stats
  totalVolume   Decimal       @default(0) @db.Decimal(18, 2)
  totalBets     Int           @default(0)
  liquidity     Decimal       @default(1000000) @db.Decimal(18, 2)

  // Status
  status        MarketStatus  @default(ACTIVE)
  featured      Boolean       @default(false)
  trending      Boolean       @default(false)

  // Resolution
  resolvedOutcomeId String?
  resolvedOutcome   Outcome?  @relation("ResolvedOutcome", fields: [resolvedOutcomeId], references: [id])
  winningOutcomeId  String?   // Alias for resolvedOutcomeId for clarity
  resolutionNotes   String?
  resolutionDetails String?   @db.Text
  resolutionSource  String?

  // Admin
  createdById   String?

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  outcomes      Outcome[]     @relation("MarketOutcomes")
  bets          Bet[]
  bookmarks     Bookmark[]
  comments      Comment[]
  priceHistory  PriceHistory[]
  marketNews    MarketNews[]

  @@index([category])
  @@index([status])
  @@index([endDate])
  @@index([featured])
  @@index([trending])
}

model Outcome {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation("MarketOutcomes", fields: [marketId], references: [id], onDelete: Cascade)

  label       String
  probability Decimal  @default(50) @db.Decimal(5, 2) // 0.00 - 100.00
  totalBets   Int      @default(0)
  volume      Decimal  @default(0) @db.Decimal(18, 2)

  // AMM state
  shares      Decimal  @default(500000) @db.Decimal(18, 2)

  // Resolution
  isWinner    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bets        Bet[]
  resolvedMarket Market? @relation("ResolvedOutcome")
  priceHistory PriceHistory[]

  @@index([marketId])
}

enum MarketStatus {
  PENDING    // Belum aktif
  ACTIVE     // Sedang berjalan
  PAUSED     // Sementara dihentikan
  CLOSED     // Sudah tutup, menunggu resolusi
  RESOLVED   // Sudah ada pemenang
  CANCELLED  // Dibatalkan, refund semua
  DISPUTED   // Ada dispute
}

enum Category {
  politik
  ekonomi
  olahraga
  hiburan
  teknologi
  sosial
  hukum
  internasional
}

model PriceHistory {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   String
  outcome     Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  probability Decimal  @db.Decimal(5, 2)
  volume      Decimal  @db.Decimal(18, 2)

  timestamp   DateTime @default(now())

  @@index([marketId, timestamp])
  @@index([outcomeId, timestamp])
}

// ============================================
// BETTING
// ============================================

model Bet {
  id              String    @id @default(cuid())

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  marketId        String
  market          Market    @relation(fields: [marketId], references: [id])

  outcomeId       String
  outcome         Outcome   @relation(fields: [outcomeId], references: [id])

  // Bet details
  amount          Decimal   @db.Decimal(18, 2)
  shares          Decimal   @db.Decimal(18, 4)
  probability     Decimal   @db.Decimal(5, 2) // Probability saat bet
  avgPrice        Decimal   @db.Decimal(10, 6)

  // Payout
  potentialPayout Decimal   @db.Decimal(18, 2)
  actualPayout    Decimal?  @db.Decimal(18, 2)
  payout          Decimal?  @db.Decimal(18, 2)
  profit          Decimal?  @db.Decimal(18, 2)

  // Cash-out
  cashedOutAt     DateTime?
  cashedOutAmount Decimal?  @db.Decimal(18, 2)

  // Status
  status          BetStatus @default(ACTIVE)

  // Timestamps
  createdAt       DateTime  @default(now())
  settledAt       DateTime?
  resolvedAt      DateTime?

  @@index([userId])
  @@index([marketId])
  @@index([outcomeId])
  @@index([status])
}

enum BetStatus {
  ACTIVE     // Masih berjalan
  WON        // Menang
  LOST       // Kalah
  CANCELLED  // Dibatalkan
  REFUNDED   // Di-refund (market cancelled)
  CASHED_OUT // Di-cash out sebelum resolusi
}

// ============================================
// TRANSACTIONS & PAYMENTS
// ============================================

model Transaction {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id])

  // Type
  type                  TransactionType

  // Amount
  amount                Decimal           @db.Decimal(18, 2)
  fee                   Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal           @db.Decimal(18, 2)

  // Payment details
  paymentMethod         PaymentMethod
  bankCode              String?
  ewalletCode           String?
  cryptoCode            String?
  cryptoNetwork         String?

  // Virtual Account / Crypto
  virtualAccountNumber  String?
  cryptoAddress         String?
  cryptoAmount          Decimal?          @db.Decimal(18, 8)
  cryptoTxHash          String?

  // External references
  externalId            String?           @unique
  uniwireInvoiceId      String?

  // Status
  status                TransactionStatus @default(PENDING)
  failureReason         String?

  // Metadata for additional info
  metadata              Json?

  // Timestamps
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  expiresAt             DateTime?
  paidAt                DateTime?

  @@index([userId])
  @@index([status])
  @@index([externalId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_REFUND
  REFUND
  REFERRAL_BONUS
  PROMO_BONUS
}

enum PaymentMethod {
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  QRIS
  CRYPTO
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  link      String?

  read      Boolean          @default(false)

  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  BET_PLACED
  BET_WON
  BET_LOST
  MARKET_RESOLVED
  DEPOSIT_COMPLETED
  WITHDRAWAL_COMPLETED
  KYC_APPROVED
  KYC_REJECTED
  REFERRAL_BONUS
  SYSTEM
}

// ============================================
// SOCIAL
// ============================================

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, marketId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  content   String   @db.Text

  // Replies
  parentId  String?
  parent    Comment? @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")

  // Stats
  likes     Int      @default(0)

  // Moderation
  isHidden  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@index([userId])
  @@index([isHidden])
}

// ============================================
// NEWS & ARTICLES
// ============================================

model News {
  id          String      @id @default(cuid())

  // Article details
  title       String
  description String?     @db.Text
  content     String?     @db.Text
  imageUrl    String?
  sourceUrl   String      @unique
  sourceName  String      // kompas, detik, cnn, etc.

  // Metadata
  author      String?
  publishedAt DateTime
  category    Category?

  // Keywords for matching with markets
  keywords    String[]    @default([])

  // Status
  isActive    Boolean     @default(true)

  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  marketNews  MarketNews[]

  @@index([sourceName])
  @@index([category])
  @@index([publishedAt])
  @@index([keywords])
}

model MarketNews {
  id        String   @id @default(cuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  // Relevance score (0-100)
  relevance Int      @default(50)

  // Admin can manually link/unlink
  isManual  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([marketId, newsId])
  @@index([marketId])
  @@index([newsId])
}

model NewsSource {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  baseUrl     String
  rssUrl      String?
  apiKey      String?

  // Settings
  isActive    Boolean  @default(true)
  fetchInterval Int    @default(30) // minutes

  // Categories this source covers
  categories  Category[]

  // Last fetch
  lastFetchAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ADMIN & SETTINGS
// ============================================

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String   // e.g., "market:123", "user:456"
  details   Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([target])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json

  updatedAt DateTime @updatedAt
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredUserId  String

  // Bonus tracking
  bonusAmount     Decimal  @db.Decimal(18, 2)
  bonusPaid       Boolean  @default(false)

  createdAt       DateTime @default(now())
  paidAt          DateTime?

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
}
