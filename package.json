{
  "name": "polymarket-indonesia",
  "version": "1.0.0",
  "private": true,
  "description": "Platform Prediction Market untuk Indonesia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@polymarket/web",
    "dev:admin": "turbo dev --filter=@polymarket/admin",
    "build": "turbo build",
    "build:web": "turbo build --filter=@polymarket/web",
    "build:admin": "turbo build --filter=@polymarket/admin",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:38207/git/herrylim2001/polymarketindonesia"
  },
  "packageManager": "npm@10.2.0"
}
